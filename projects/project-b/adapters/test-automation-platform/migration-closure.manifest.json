  "exclusions": [
    {
      "id": "platform-third-party-dependencies",
      "rootId": "platform",
      "patterns": [
        "node_modules",
        "node_modules/**"
      ],
      "reason": "第三方依赖不属于平台自有测试资产"
    },
    {
      "id": "workspace-source-control-metadata",
      "rootId": "workspace",
      "patterns": [
        ".git",
        ".git/**",
        "**/.git",
        "**/.git/**"
      ],
      "reason": "源代码管理内部元数据不属于测试资产"
    },
    {
      "id": "workspace-third-party-dependencies",
      "rootId": "workspace",
      "patterns": [
        "**/node_modules",
        "**/node_modules/**"
      ],
      "reason": "第三方依赖不属于项目自有测试资产"
    },
    {
      "id": "workspace-secret-and-session-material",
      "rootId": "workspace",
      "patterns": [
        ".secrets",
        ".secrets/**",
        ".runtime",
        ".runtime/**",
        "**/.auth",
        "**/.auth/**"
      ],
      "reason": "密钥、登录态和本机运行缓存只允许由安全机制管理，不进入迁移报告"
    },
    {
      "id": "workspace-self-generated-closure-report",
      "rootId": "workspace",
      "patterns": [
        "Merchant Center UITest/adapters/test-automation-platform/reports/merchant-center-migration-closure.json",
        "Merchant Center UITest/adapters/test-automation-platform/reports/merchant-center-migration-closure.md"
      ],
      "reason": "排除审计器自身输出，避免报告内容反向改变输入指纹"
    },
    {
      "id": "workspace-migration-inventory-baseline",
      "rootId": "workspace",
      "patterns": [
        "Merchant Center UITest/adapters/test-automation-platform/reports/migration-inventory.baseline.json"
      ],
      "reason": "迁移前后完整性基线由迁移审计器独立读取，不能反向改变扫描输入"
    },
    {
      "id": "workspace-audit-transients",
      "rootId": "workspace",
      "patterns": [
        "Merchant Center UITest/tmp-audit/**"
      ],
      "reason": "浏览器审计 trace、资源和临时结果属于瞬态证据，不纳入迁移归属清单"
    }
