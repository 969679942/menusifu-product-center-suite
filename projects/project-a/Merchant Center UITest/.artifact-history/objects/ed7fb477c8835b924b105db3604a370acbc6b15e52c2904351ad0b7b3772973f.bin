  "rows": [
    {
      "caseId": "TC-ITEM-ADD-014",
      "source": {
        "caseId": "TC-ITEM-ADD-014",
        "preconditions": [
          "登录商品中心，选择商户(Brand ID为:000407)，点击确定进入商品中心首页",
          "当前品牌下不存在与本次冲突的同名测试商品（本用例商品名称：「加料商品-同一一级分类下同名创建-{当前时间戳毫秒}」）",
          "当前品牌下已存在名称为 `ADD_DUP_001` 的加料商品。",
          "当前品牌下另有名称为 `ADD_EDIT_TARGET_001` 的加料商品，用于编辑判重。",
          "已打开加料商品创建页。"
        ],
        "steps": [
          "点击侧边栏【商品管理】-【商品】，进入商品列表页",
          "点击右上角【新增商品】按钮，进入选择商品类型页面",
          "点击【配菜/加料】-【去创建】，进入创建加料/配菜商品页面",
          "填写与已有加料商品同名的商品名称、同一一级分类、标准价 `5.00`",
          "点击右上角【保存】按钮",
          "读取接口响应错误码并按商品名称查询列表记录数",
          "返回列表打开 `ADD_EDIT_TARGET_001` 编辑页，将名称改为 `ADD_DUP_001` 并保存",
          "读取编辑接口响应错误码，重新进入编辑页并按名称查询列表"
        ],
        "expectedResults": [
          "保存失败，UI 提示 `BITEM-7014：商品名称与其它类型商品名称重复`。",
          "API 返回错误码 `BITEM-7014`，同名加料商品记录数不增加。",
          "编辑同类型重复名称同样失败，UI/API 均返回 `BITEM-7014`，编辑目标原名称保持不变，列表仍展示原名称。"
        ],
        "sources": [
          "产品确认明确 ← BR-ITEM-010"
        ],
        "title": "同一商户同一商品类型内加料商品同名创建或编辑失败",
        "fingerprint": "af0488cafc60432adb66969fe7f90db1b79e55f4697f9d16e1f451d7869a1780"
      },
      "reasons": [
        "SOURCE_ACTIONS_7_8_EDIT_SCENARIO_NOT_EXECUTED",
        "SOURCE_ASSERTION_3_REPLACED_WITH_CREATE_COUNT",
        "EXPECTED_BITEM_7014_OBSERVED_BITEM_7010",
        "SOURCE_NAVIGATION_1_3_NOT_PROVEN_BY_DIRECT_OPEN"
      ],
      "nextAction": "补正式导航和独立编辑目标；创建与编辑分别核对 BITEM-7014、名称与列表。7010 只登记实际观察，不能归为语言等价；实现缺口自动修复，正式规则与稳定行为冲突另行取证。",
      "formalPassQualified": false,
      "receiptAssertions": [
        {
