      "caseId": "TC-ITEM-ADD-015",
      "source": {
        "caseId": "TC-ITEM-ADD-015",
        "preconditions": [
          "登录商品中心，选择商户(Brand ID为:000407)，点击确定进入商品中心首页",
          "当前品牌下不存在名称为 `CROSS_DUP_002` 或 `STD_RENAME_SOURCE_001` 的商品。",
          "当前商户下已存在名称为 `ADD_RENAME_TARGET_001` 的加料商品。",
          "已打开加料商品创建页。"
        ],
        "steps": [
          "创建名称为 `CROSS_DUP_002` 的标准商品。",
          "进入加料商品创建页并填写相同商品名称 `CROSS_DUP_002`。",
          "点击保存。",
          "核对同名标准商品和加料商品均存在。",
          "创建名称为 `STD_RENAME_SOURCE_001` 的标准商品并进入其编辑页。",
          "将标准商品名称修改为已有加料商品名称 `ADD_RENAME_TARGET_001`，点击保存。",
          "分别读取创建/编辑接口响应并按名称和商品类型查询列表。"
        ],
        "expectedResults": [
          "加料商品允许与其他商品类型使用相同商品名称；保存成功后同名标准商品和加料商品均保留。",
          "UI 无重复拦截，API 创建响应成功，列表按名称查询到两条不同商品类型记录。",
          "标准商品改名为已存在的加料商品名称时允许保存；UI 无重复拦截，API 编辑响应成功，列表展示新名称且原标准商品名称不再存在。"
        ],
        "sources": [
          "产品确认明确 ← BR-ITEM-010；金将军人工处理确认 ← output\\product-center-item-213-failures\\failure-pack.md#tc-item-add-015"
        ],
