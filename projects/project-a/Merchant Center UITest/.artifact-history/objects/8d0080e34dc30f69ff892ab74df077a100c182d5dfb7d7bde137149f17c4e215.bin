        {
          "id": "TC-ITEM-ADD-024:action-1",
          "kind": "source-operation-mapping",
          "sourceText": "点击侧边栏【商品管理】-【商品】，进入商品列表页面"
        },
        {
          "id": "TC-ITEM-ADD-024:action-2",
          "kind": "source-operation-mapping",
          "sourceText": "在左上角商品名称输入框填写：加料商品-改价测试，等待列表数据自动刷新"
        },
        {
          "id": "TC-ITEM-ADD-024:action-3",
          "kind": "source-operation-mapping",
          "sourceText": "点击商品类型，弹出下拉框选择：加料/配菜，等待列表数据自动刷新"
        },
        {
          "id": "TC-ITEM-ADD-024:action-4",
          "kind": "source-operation-mapping",
          "sourceText": "确认列表查询出「加料商品-改价测试」，列表展示标准价为 5.00"
        },
        {
          "id": "TC-ITEM-ADD-024:action-5",
          "kind": "source-operation-mapping",
          "sourceText": "点击列表第一行商品名称「加料商品-改价测试」，进入编辑页"
        },
        {
          "id": "TC-ITEM-ADD-024:action-6",
          "kind": "source-operation-mapping",
          "sourceText": "在「商品价格」区域，将「标准价」由 5.00 修改为 8.88"
        },
        {
          "id": "TC-ITEM-ADD-024:action-7",
          "kind": "source-operation-mapping",
          "sourceText": "点击右上角【保存】按钮"
        },
        {
          "id": "TC-ITEM-ADD-024:action-8",
          "kind": "source-operation-mapping",
          "sourceText": "页面返回商品列表，等待列表刷新；再次按名称+类型查询该商品"
        },
        {
          "id": "TC-ITEM-ADD-024:expectation-1",
          "kind": "assertion-observation",
          "sourceText": "保存成功提示：页面展示「提交成功」的 Toast 提示"
        },
        {
          "id": "TC-ITEM-ADD-024:expectation-2",
          "kind": "assertion-observation",
          "sourceText": "列表价格校验：列表中「加料商品-改价测试」的标准价更新为 8.88"
        },
        {
          "id": "TC-ITEM-ADD-024:expectation-3",
          "kind": "assertion-observation",
          "sourceText": "编辑页回显校验：再次进入该商品编辑页，「标准价」回显为 8.88"
        },
        {
          "id": "TC-ITEM-ADD-024:expectation-4",
          "kind": "assertion-observation",
          "sourceText": "其他字段校验：商品名称、商品类型（加料/配菜）未因本次保存发生变化"
        }
      ],
