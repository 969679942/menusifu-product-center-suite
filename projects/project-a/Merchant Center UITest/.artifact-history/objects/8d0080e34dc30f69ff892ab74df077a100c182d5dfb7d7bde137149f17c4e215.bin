      "sourceQuestions": [
        {
          "id": "TC-ITEM-STD-007:action-1",
          "kind": "source-operation-mapping",
          "sourceText": "点击侧边栏【商品管理】-【商品】，进入商品列表页"
        },
        {
          "id": "TC-ITEM-STD-007:action-2",
          "kind": "source-operation-mapping",
          "sourceText": "点击【新增商品】并选择【标准商品】，进入创建页"
        },
        {
          "id": "TC-ITEM-STD-007:action-3",
          "kind": "source-operation-mapping",
          "sourceText": "打开【商品分类】下拉框"
        },
        {
          "id": "TC-ITEM-STD-007:action-4",
          "kind": "source-operation-mapping",
          "sourceText": "点击一级分类A"
        },
        {
          "id": "TC-ITEM-STD-007:action-5",
          "kind": "source-operation-mapping",
          "sourceText": "点击二级分类A1"
        },
        {
          "id": "TC-ITEM-STD-007:action-6",
          "kind": "source-operation-mapping",
          "sourceText": "填写其他必填字段并保存商品"
        },
        {
          "id": "TC-ITEM-STD-007:action-7",
          "kind": "source-operation-mapping",
          "sourceText": "在列表按商品分类 A1 过滤并进入编辑详情"
        },
        {
          "id": "TC-ITEM-STD-007:action-8",
          "kind": "source-operation-mapping",
          "sourceText": "编辑时重新选择另一个一级/二级分类路径并保存，再次按分类过滤并打开编辑详情"
        },
        {
          "id": "TC-ITEM-STD-007:action-9",
          "kind": "source-operation-mapping",
          "sourceText": "尝试将有二级分类的一级分类直接作为最终分类后保存"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-1",
          "kind": "assertion-observation",
          "sourceText": "点击一级分类A后，下拉框展开二级分类；一级分类A不作为最终已选分类"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-2",
          "kind": "assertion-observation",
          "sourceText": "点击二级分类A1后，商品分类字段显示二级分类A1，分类选择完成"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-3",
          "kind": "assertion-observation",
          "sourceText": "商品分类字段非必填，分类选择与商品创建成功/失败无关"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-4",
          "kind": "assertion-observation",
          "sourceText": "保存后列表可按商品分类 A1 过滤到本次商品，编辑详情回显 A1"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-5",
          "kind": "assertion-observation",
          "sourceText": "编辑可重新选择合法一级/二级分类路径，保存后列表过滤和编辑详情回显新叶子分类"
        },
        {
          "id": "TC-ITEM-STD-007:expectation-6",
          "kind": "assertion-observation",
          "sourceText": "有二级分类时不能将一级分类作为最终值，保存不得接受该非叶子分类"
        }
      ],
