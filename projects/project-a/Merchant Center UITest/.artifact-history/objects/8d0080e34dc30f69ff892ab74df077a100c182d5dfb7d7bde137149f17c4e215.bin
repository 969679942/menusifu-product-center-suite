        {
          "id": "TC-ITEM-ADD-026:action-1",
          "kind": "source-operation-mapping",
          "sourceText": "点击侧边栏【商品管理】-【商品】，进入商品列表页面"
        },
        {
          "id": "TC-ITEM-ADD-026:action-2",
          "kind": "source-operation-mapping",
          "sourceText": "在左上角商品名称输入框填写：红枣，等待列表数据自动刷新"
        },
        {
          "id": "TC-ITEM-ADD-026:action-3",
          "kind": "source-operation-mapping",
          "sourceText": "确认列表正确查询出「红枣」商品（商品类型：加料/配菜）"
        },
        {
          "id": "TC-ITEM-ADD-026:action-4",
          "kind": "source-operation-mapping",
          "sourceText": "点击列表第一行（红枣）操作列的【...】按钮，在弹出的下拉菜单中点击【删除】按钮"
        },
        {
          "id": "TC-ITEM-ADD-026:action-5",
          "kind": "source-operation-mapping",
          "sourceText": "在弹出的确认删除弹窗中核对提示文案：确定要删除该加料商品吗？，点击【删除】按钮"
        },
        {
          "id": "TC-ITEM-ADD-026:action-6",
          "kind": "source-operation-mapping",
          "sourceText": "等待页面提示消失及列表数据自动刷新"
        },
        {
          "id": "TC-ITEM-ADD-026:expectation-1",
          "kind": "assertion-observation",
          "sourceText": "删除成功提示：页面展示「删除成功」的 Toast 提示"
        },
        {
          "id": "TC-ITEM-ADD-026:expectation-2",
          "kind": "assertion-observation",
          "sourceText": "列表刷新校验：列表自动刷新后，「红枣」商品已不存在"
        },
        {
          "id": "TC-ITEM-ADD-026:expectation-3",
          "kind": "assertion-observation",
          "sourceText": "总条数校验：左下角查询总条数较删除前减少 1（若当前查询条件下仅 1 条）"
        }
      ],
