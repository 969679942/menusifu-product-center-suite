      "sourceQuestions": [
        {
          "id": "TC-ITEM-PKG-059:action-1",
          "kind": "source-operation-mapping",
          "sourceText": "打开已添加可选搭配组的套餐商品编辑页"
        },
        {
          "id": "TC-ITEM-PKG-059:action-2",
          "kind": "source-operation-mapping",
          "sourceText": "展开可选搭配组卡片"
        },
        {
          "id": "TC-ITEM-PKG-059:action-3",
          "kind": "source-operation-mapping",
          "sourceText": "查看组规则摘要、右上角组级操作和组内商品行"
        },
        {
          "id": "TC-ITEM-PKG-059:action-4",
          "kind": "source-operation-mapping",
          "sourceText": "点击组级编辑，修改组配置并保存，重新打开该套餐商品编辑页"
        },
        {
          "id": "TC-ITEM-PKG-059:action-5",
          "kind": "source-operation-mapping",
          "sourceText": "核对关联套餐商品已反映组级编辑结果"
        },
        {
          "id": "TC-ITEM-PKG-059:action-6",
          "kind": "source-operation-mapping",
          "sourceText": "在品牌侧重新下发菜单或点击“同步到门店”，核对门店数据更新"
        },
        {
          "id": "TC-ITEM-PKG-059:action-7",
          "kind": "source-operation-mapping",
          "sourceText": "尝试从品牌商品管理同步终端，确认终端不因该操作更新"
        },
        {
          "id": "TC-ITEM-PKG-059:action-8",
          "kind": "source-operation-mapping",
          "sourceText": "进入门店商品管理执行同步，核对终端已反映组级编辑结果"
        },
        {
          "id": "TC-ITEM-PKG-059:action-9",
          "kind": "source-operation-mapping",
          "sourceText": "点击组级删除，在确认框中选择取消"
        },
        {
          "id": "TC-ITEM-PKG-059:action-10",
          "kind": "source-operation-mapping",
          "sourceText": "再次点击组级删除，在确认框中选择确认"
        },
        {
          "id": "TC-ITEM-PKG-059:action-11",
          "kind": "source-operation-mapping",
          "sourceText": "核对关联套餐商品已移除被删除的组"
        },
        {
          "id": "TC-ITEM-PKG-059:action-12",
          "kind": "source-operation-mapping",
          "sourceText": "在品牌侧重新下发菜单或点击“同步到门店”，核对门店数据更新"
        },
        {
          "id": "TC-ITEM-PKG-059:action-13",
          "kind": "source-operation-mapping",
          "sourceText": "再次进入门店商品管理执行同步，核对终端已反映组级删除结果"
        },
        {
          "id": "TC-ITEM-PKG-059:action-14",
          "kind": "source-operation-mapping",
          "sourceText": "查看组卡片、商品行、套餐详情和商品列表，并通过接口查询确认清理结果"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-1",
          "kind": "assertion-observation",
          "sourceText": "组卡片展示组内商品是否允许重复选择和选择数量规则"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-2",
          "kind": "assertion-observation",
          "sourceText": "组卡片右上角展示整个组的编辑和删除入口"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-3",
          "kind": "assertion-observation",
          "sourceText": "商品行展示名称、规格、最小数量、最大数量和默认选中状态，不提供单个商品移除入口"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-4",
          "kind": "assertion-observation",
          "sourceText": "组级编辑保存后重新打开商品，组配置与保存结果一致"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-5",
          "kind": "assertion-observation",
          "sourceText": "组级编辑确认后关联套餐商品配置更新"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-6",
          "kind": "assertion-observation",
          "sourceText": "菜单重新下发或“同步到门店”后门店数据更新"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-7",
          "kind": "assertion-observation",
          "sourceText": "从品牌商品管理同步不更新终端"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-8",
          "kind": "assertion-observation",
          "sourceText": "通过门店商品管理同步后终端数据更新"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-9",
          "kind": "assertion-observation",
          "sourceText": "删除先弹出确认框；取消删除保持原组卡片和商品数据不变"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-10",
          "kind": "assertion-observation",
          "sourceText": "确认删除后删除操作提交"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-11",
          "kind": "assertion-observation",
          "sourceText": "关联套餐商品移除被删除的组"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-12",
          "kind": "assertion-observation",
          "sourceText": "菜单重新下发或“同步到门店”后门店数据移除该组"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-13",
          "kind": "assertion-observation",
          "sourceText": "通过门店商品管理同步后终端数据移除该组；品牌商品管理不能直接同步终端"
        },
        {
          "id": "TC-ITEM-PKG-059:expectation-14",
          "kind": "assertion-observation",
          "sourceText": "确认删除后移除该组，组卡片、商品行、套餐详情和列表均不再展示该组；接口查询确认组及关联残留符合清理要求"
        }
      ],
