        "effectiveFrom": "current-production-as-of-2026-09-02",
        "changeReason": "direct-user-confirmation:BR-ITEM-010",
        "timeEvidenceStatus": "partial",
        "effectiveContextStatus": "explicit"
      }
    }
  ]
