{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menusifu.local/schemas/product-center-test-contract-v1.json",
  "title": "商品中心黑盒测试合同",
  "type": "object",
  "required": ["metadata", "routes", "controls", "fields", "dialogs", "validations", "apiOperations", "uiApiMappings", "businessRules", "testDataFactories", "cleanupAdapters", "assertions", "traceability", "unresolved"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "routes": { "$ref": "#/$defs/records" },
    "controls": { "$ref": "#/$defs/records" },
    "fields": { "$ref": "#/$defs/records" },
    "dialogs": { "$ref": "#/$defs/records" },
    "validations": { "$ref": "#/$defs/records" },
    "apiOperations": { "$ref": "#/$defs/records" },
    "uiApiMappings": { "$ref": "#/$defs/records" },
    "businessRules": { "$ref": "#/$defs/records" },
    "testDataFactories": { "$ref": "#/$defs/records" },
    "cleanupAdapters": { "$ref": "#/$defs/records" },
    "assertions": { "$ref": "#/$defs/records" },
    "traceability": { "$ref": "#/$defs/records" },
    "unresolved": { "$ref": "#/$defs/records" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": ["contractVersion", "generatedAt", "sourceFingerprint", "sourcePriority", "sourceArtifacts", "collections", "counts"],
      "properties": {
        "contractVersion": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "minLength": 1 },
        "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sourcePriority": { "type": "array", "items": { "type": "string" } },
        "sourceArtifacts": { "type": "array", "items": { "type": "string" } },
        "collections": { "type": "array", "minItems": 13, "items": { "type": "string" } },
        "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "sourceType", "confidence", "generationAllowed", "source", "verifiedAt", "version", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["observed", "confirmed", "provisional", "inferred", "blocked", "unresolved", "not-applicable", "generated"] },
          "sourceType": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "generationAllowed": { "type": "boolean" },
          "source": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string", "minLength": 1 } } } },
          "verifiedAt": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "evidence": { "type": "object" }
        }
      }
    }
  }
}
