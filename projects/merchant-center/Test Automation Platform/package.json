{
  "name": "@menusifu/test-automation-platform",
  "version": "1.0.0",
  "private": true,
  "description": "通用、跨方案、跨系统的测试方案编译、执行、证据和治理核心",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "boundary": "tsx scripts/check-boundary.ts",
    "architecture:check": "tsx scripts/check-ui-architecture.ts",
    "capabilities": "tsx scripts/generate-capability-index.ts",
    "audit:migration-closure": "tsx scripts/audit-migration-closure.ts",
    "lifecycle:project": "tsx scripts/run-project-lifecycle.ts",
    "scaffold": "tsx scripts/scaffold-system-test.ts",
    "scaffold:project-adapter": "tsx scripts/scaffold-project-adapter.ts",
    "compile": "tsx scripts/compile-system-test-plan.ts",
    "build": "tsx scripts/build-system-test-contract.ts",
    "run": "tsx scripts/run-system-test-cli.ts",
    "compile:system-test-plan": "tsx scripts/compile-system-test-plan.ts",
    "build:system-test": "tsx scripts/build-system-test-contract.ts",
    "plan:test-plan:optimization": "tsx scripts/build-system-test-optimization-plan.ts",
    "test:system": "tsx scripts/run-system-test-cli.ts",
    "flow": "tsx scripts/run-system-test-flow.ts",
    "recover:evidence-ledger": "tsx scripts/recover-system-test-evidence-ledger.ts",
    "audit:local": "tsx scripts/run-system-test-audit-pipeline.ts",
    "verify:audit-reference": "tsx scripts/run-system-test-audit-pipeline.ts --reference",
    "verify-reference": "tsx scripts/verify-system-test-reference.ts",
    "verify:system-test-platform": "tsx scripts/verify-system-test-platform.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "playwright test --project=api --workers=1",
    "test:business-rule-coverage": "playwright test tests/api/business-rule-coverage.contract.spec.ts --project=api --workers=1 --reporter=line",
    "test:business-rule-trigger": "playwright test tests/api/business-rule-change-trigger.contract.spec.ts tests/api/business-rule-lifecycle.contract.spec.ts tests/api/business-rule-change-event.contract.spec.ts --project=api --workers=1 --reporter=line",
    "test:acceptance": "playwright test tests/api/acceptance-core.contract.spec.ts tests/api/acceptance-route-scanner.contract.spec.ts tests/api/acceptance-orchestrator.contract.spec.ts tests/api/process-governance.contract.spec.ts --project=api --workers=1",
    "test:migration-closure": "playwright test tests/api/migration-closure.contract.spec.ts --project=api --workers=1",
    "test:enterprise-governance": "playwright test tests/api/enterprise-governance.contract.spec.ts --project=api --workers=1 --reporter=line",
    "ci": "npm run typecheck && npm test -- --reporter=line && npm run boundary && npm run architecture:check && npm run capabilities -- --check && npm audit --omit=dev"
  }
}
