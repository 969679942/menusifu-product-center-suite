{
  "schemaVersion": 2,
  "transportRepository": "menusifu-product-center-suite",
  "sourceRepositories": ["969679942/Merchant-Center"],
  "jobName": "menusifu-product-center-suite",
  "fixedBranches": {
    "mc": "main",
    "tapContractPackage": "@menusifu/tap-contract@1.1.3",
    "enforcement": "single-project-with-fixed-contract-package"
  },
  "defaultTriggerMode": "manual-parameterized",
  "automaticTriggerStatus": "external-configuration-required",
  "allowedTriggerSources": [
    "explicit-local-submit",
    "github-webhook",
    "scm-trigger",
    "workflow-dispatch"
  ],
  "requiredIdentity": [
    "MC_GIT_SHA",
    "REQUEST_ID",
    "INTENT_ID",
    "RUN_SCOPE",
    "TRIGGER_SOURCE"
  ],
  "fullRegression": {
    "requiresExplicitScope": true,
    "selectionAuthority": "mc-compiled-contract-exact-set",
    "defaultOnPush": "pilot",
    "businessExecutionOnMissingTriggerEvidence": "blocked",
    "timeoutMinutes": 360
  },
  "executionIsolation": {
    "disableConcurrentBuildsRequired": true,
    "workspaceTemplate": "${WORKSPACE}@${BUILD_NUMBER}-isolated",
    "defaultTimeoutMinutes": 180,
    "auditEventLogMode": "worker-sharded-then-merged"
  },
  "governance": {
    "sourcePushMustNotBeReportedAsJenkinsBuildWithout回执": true,
    "unreachableEndpointStatus": "external-authorization-blocked",
    "separateServerReachabilityFromTriggerConfiguration": true,
    "separateTriggerFromBusinessExecution": true,
    "releasePreflightRequired": true,
    "forcePushForbidden": true,
    "preflightScript": "Merchant Center UITest/scripts/validate-product-center-execution-contract.ts",
    "contractPackage": "@menusifu/tap-contract@1.1.3"
  }
}
